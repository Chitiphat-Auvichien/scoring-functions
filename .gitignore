# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Large source spreadsheet (important columns are split into CSV in data/ instead)
data/*.xlsx

# scripts/compare_rerun.py's throwaway mirror data directory (NTFS junctions
# into data/logs_rerun|gjf_rerun|EMIT + copied static CSVs + generated
# results/figures) -- cheaply rebuildable, not source. See scripts/compare_rerun.py.
data/_rerun_mirror/

# ped/archive_python_ped/ pipeline intermediate artifacts (regenerated by
# run_all.sh from inside archive_python_ped/, not source)
ped/archive_python_ped/*.npy
ped/archive_python_ped/opt_symbols.txt
ped/archive_python_ped/bonds.txt
ped/archive_python_ped/coord_labels.txt
ped/archive_python_ped/cats.txt

# ped/archive_python_ped/ VEDA-style cross-check intermediate artifacts
# (regenerated by run_veda_style.sh; final tables/reports below are kept)
ped/archive_python_ped/nat_coord_labels.txt
ped/archive_python_ped/epm_history.txt

# ped/archive_python_ped/11_inspect_coordinate.py's ad hoc diagnostic images
# (regenerated on demand, not a source or a manuscript figure)
ped/archive_python_ped/inspect_coord_*.png

# ped/build_veda_fmt.py's generated .fmt output -- regenerable, not source
# (ped/reference/*.fmt below is the tracked, VEDA4-validated baseline and is
# NOT covered by this pattern)
ped/output/*
!ped/output/.gitkeep

# Internal planning log -- kept locally only, not published (still in
# git history from before it was untracked)
IMPLEMENTATION_PLAN.md

# OS / editor cruft
.DS_Store
Thumbs.db
